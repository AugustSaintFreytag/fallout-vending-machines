begin Function {}

	; References

	ref GetTimeLastLockedUDF = CompileScript "SaintsVendingMachines\Locking\GetTimeLastLocked.gek"
	ref SetTimeLastLockedUDF = CompileScript "SaintsVendingMachines\Locking\SetTimeLastLocked.gek"
	ref GetRandomLockLevelUDF = CompileScript "SaintsVendingMachines\Locking\GetRandomLockLevel.gek"

	; Scan

	float fDaysPassed = GetGameDaysPassed 2277 08 17
	array_var aLoadedReferences = Player.GetRefs 27 -1 1
	short iNumLoadedReferences = Ar_Size aLoadedReferences

	;PrintC "Player entered cell with %g container(s)." iNumLoadedReferences
	
	short iReferenceIndex = 0

	while iReferenceIndex < Ar_Size aLoadedReferences
		ref rObject = aLoadedReferences[iReferenceIndex]

		if eval (!rObject)
			let iReferenceIndex += 1
			continue
		endif

		if eval !(HasKeyword rObject "NukaColaVendingMachine")
			let iReferenceIndex += 1
			continue
		endif

		float fTimeLastLocked = (Call GetTimeLastLockedUDF rObject)
		
		if rObject.GetLocked == 0
			if eval (fTimeLastLocked == -1) || (fDaysPassed - fTimeLastLocked) > 3.0
				short iLockLevel = Call GetRandomLockLevelUDF
				rObject.Lock iLockLevel

				;PrintC "Locked vending machine '%z' with lock level %g." (GetFormIDString rObject) iLockLevel
			else
				;PrintC "Did not lock vending machine '%z', already locked recently (days passed %.2f, time last locked %.2f)." (GetFormIDString rObject) fDaysPassed fTimeLastLocked
			endif
		else
			;PrintC "Skipping already locked vending machine '%z'." (GetFormIDString rObject)
		endif

		; Either reference was locked or was already locked, always renew timer.
		Call SetTimeLastLockedUDF rObject
		let iReferenceIndex += 1
	loop

	; Clean-Up

	let aLoadedReferences := Ar_Null

end