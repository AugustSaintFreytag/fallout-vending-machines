begin function { ref rObject }

	array_var aStock = Ar_Construct "stringmap"

	if eval !rObject
		SetFunctionValue aStock
		let aStock := Ar_Null
		return
	endif

	ref rWorldspace = rObject.GetParentWorldspace

	if eval !rWorldspace
		PrintC "Could not read parent worldspace for vending machine object '%z'." (GetEditorID rObject)
		SetFunctionValue aStock
		let aStock := Ar_Null
		return
	endif

	string_var sWorldspaceName = GetEditorID rWorldspace

	if eval sWorldspaceName == "MegatonWorld"
		let aStock["_Any"] := 1
		let aStock["Nuka-Cola"] := 1
	elseif eval sWorldspaceName == "DLC4Pointlookout"
		let aStock["_Any"] := 1
		let aStock["Nuka-Cola"] := 1
	else
		PrintC "No regional vending machine stock for world space '%z'." (sWorldspaceName)
	endif

	SetFunctionValue aStock
	Sv_Destruct sWorldspaceName

	let aStock := Ar_Null

end