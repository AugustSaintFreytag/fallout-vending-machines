begin function { ref rObject }

	ref GetStockRegionalUDF = CompileScript "SaintsVendingMachines\Stock\GetStockRegional.gek"
	ref GetStockDefaultUDF = CompileScript "SaintsVendingMachines\Stock\GetStockDefault.gek"

	array_var aStock

	; Regional

	let aStock := (Call GetStockRegionalUDF rObject)

	if eval (Ar_Size aStock) > 0
		; Regional stock override exists, return.
		SetFunctionValue aStock
		return
	endif

	; Default

	let aStock := (Call GetStockDefaultUDF rObject)
	SetFunctionValue aStock

end