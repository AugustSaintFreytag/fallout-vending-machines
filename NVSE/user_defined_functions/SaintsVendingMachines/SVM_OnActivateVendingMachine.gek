begin function { int iButton }

	; UDFs

	ref VendingMachineActivateUDF = CompileScript ("SaintsVendingMachines\SVM_OnActivateVendingMachine.gek")
	ref GetSeededRandomChanceUDF = CompileScript ("SaintsVendingMachines\SVM_GetSeededRandomChance.gek")

	; Init

	short iIndex = -1

	ref rActivated = GetCrosshairRef

	if eval rActivated == 0
		return
	endif

	ref rOwner = rActivated.GetOwner

	; Currency

	ref rCurrency = PrewarMoney
	string_var sCurrencyName = "Pre-War Money"

	; Sounds

	ref rOpenSound = GetContainerSound rActivated 0	
	ref rCloseSound = GetContainerSound rActivated 1

	if IsFormValid rOpenSound
		PlaySound rOpenSound 1
	endif

	short iMachinePosX = rActivated.GetPos X
	short iMachinePosY = rActivated.GetPos Y
	short iMachinePosZ = rActivated.GetPos Z

	short iMachineSeed = iMachinePosX + iMachinePosY - iMachinePosZ

	; Vending

	; NukaCola, MS05IceNukaCola, MS05NukaColaQtm, NVNukaColaQuartz, NVNukaColaVictory, SSBottleFull, IrradiatedSSBottleFull

	short bHasBottles = 0
	short bHasNukaCola = 0
	short bHasNukaColaQuantum = 0
	short bHasNukaColaQuartz = 0
	short bHasNukaColaVictory = 0

	; Stock Pseudo-Randomization

	if eval Player.IsInInterior == 1
		let bHasNukaCola := (Call GetSeededRandomChanceUDF iMachineSeed) < 70
		let bHasNukaColaQuantum := (Call GetSeededRandomChanceUDF (iMachineSeed + 1)) < 50
		let bHasNukaColaQuartz := (Call GetSeededRandomChanceUDF (iMachineSeed + 2)) < 10
		let bHasNukaColaVictory := (Call GetSeededRandomChanceUDF (iMachineSeed + 3)) < 5

		let bHasBottles := eval (bHasNukaCola || bHasNukaColaQuantum || bHasNukaColaQuartz || bHasNukaColaVictory)
	else
		let bHasNukaCola := (Call GetSeededRandomChanceUDF iMachineSeed) < 50
		let bHasNukaColaQuantum := (Call GetSeededRandomChanceUDF iMachineSeed + 1) < 20
		let bHasNukaColaQuartz := (Call GetSeededRandomChanceUDF iMachineSeed + 2) < 0
		let bHasNukaColaVictory := (Call GetSeededRandomChanceUDF iMachineSeed + 3) < 0

		let bHasBottles := eval (bHasNukaCola || bHasNukaColaQuantum || bHasNukaColaQuartz || bHasNukaColaVictory)
	endif

	short iSampleValue = Call GetSeededRandomChanceUDF (iMachineSeed + 4)
	PrintC "Set vending machine stock: Classic (%g), Quantum (%g), Quartz (%g), Victory (%g)." bHasNukaCola bHasNukaColaQuantum bHasNukaColaQuartz bHasNukaColaVictory

	; Stock Check

	if eval bHasBottles == 0
		PrintC "The vending machine was set to be out of stock."
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|This vending machine is out of stock."
	endif

	; Activation

	if eval (bHasBottles) && (HasKeyword rActivated "NukaColaVendingMachine")
		PrintC "Vending machine detected to be Nuka-Cola type."

		if eval rCurrency == PrewarMoney
			let string_var sMenuText := "This vending machine accepts legal US tender.%rYou have $%g in your inventory."
		elseif eval rCurrency == Caps001
			let string_var sMenuText := "This vending machine has been modified to accept Bottle Caps.%rYou have %g Bottle Caps in your inventory."
		endif

		; Nuka-Cola

		if eval bHasNukaCola == 1
			let iIndex += 1
			let sMenuText += ("|Nuka-Cola ($10)")

			if iButton == iIndex
				if (Player.GetItemCount rCurrency) < 1
					MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You don't have enough Pre-War Money to make this purchase."
				else
					Player.RemoveItem PrewarMoney 1 1
					Player.AddItem NukaCola 1
					PlaySound PHYBottleH 1
				endif
				
				if IsFormValid rCloseSound
					PlaySound rCloseSound 1
				endif
			endif
		endif

		; Nuka-Cola Quantum

		if eval bHasNukaColaQuantum == 1
			let iIndex += 1
			let sMenuText += ("|Nuka-Cola Quantum ($30)")

			if iButton == iIndex
				if (Player.GetItemCount rCurrency) < 3
					MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You don't have enough Pre-War Money to make this purchase."
				else
					Player.RemoveItem PrewarMoney 3 1
					Player.AddItem MS05NukaColaQtm 1
					PlaySound PHYBottleH 1
				endif
				
				if IsFormValid rCloseSound
					PlaySound rCloseSound 1
				endif
			endif
		endif

		; Nuka-Cola Quartz

		if eval bHasNukaColaQuartz == 1
			let iIndex += 1
			let sMenuText += ("|Nuka-Cola Quartz ($50)")

			if iButton == iIndex
				if (Player.GetItemCount rCurrency) < 5
					MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You don't have enough Pre-War Money to make this purchase."
				else
					Player.RemoveItem PrewarMoney 5 1
					Player.AddItem NVNukaColaQuartz 1
					PlaySound PHYBottleH 1
				endif
				
				if IsFormValid rCloseSound
					PlaySound rCloseSound 1
				endif
			endif
		endif

		; Nuka-Cola Victory

		if eval bHasNukaColaVictory == 1
			let iIndex += 1
			let sMenuText += ("|Nuka-Cola Victory ($50)")

			if iButton == iIndex
				if (Player.GetItemCount rCurrency) < 5
					MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|You don't have enough Pre-War Money to make this purchase."
				else
					Player.RemoveItem PrewarMoney 5 1
					Player.AddItem NVNukaColaVictory 1
					PlaySound PHYBottleH 1
				endif
				
				if IsFormValid rCloseSound
					PlaySound rCloseSound 1
				endif
			endif
		endif

		; Finalize

		let iIndex += 1
		let sMenuText += "|Cancel"

		if eval iButton == iIndex
			if IsFormValid rCloseSound
				PlaySound rCloseSound 1
			endif
		endif

		if eval iButton == -1
			MessageBoxExAlt VendingMachineActivateUDF (ToString $(sMenuText)) ((Player.GetItemCount PrewarMoney) * 10)
		endif
	endif

	; Clean-Up

	Sv_Destruct sCurrencyName, sMenuText

end