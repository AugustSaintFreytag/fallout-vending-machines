begin function { ref rObject }

	; UDFs

	ref OnMenuConfirmUDF = CompileScript "SaintsVendingMachines\OnMenuConfirm.gek"
	ref GetSeededRandomChanceUDF = CompileScript "SaintsVendingMachines\Utility\GetSeededRandomChance.gek"

	ref GetProductItemsUDF = CompileScript "SaintsVendingMachines\Products\GetProductItems.gek"
	ref GetProductPricesUDF = CompileScript "SaintsVendingMachines\Products\GetProductPrices.gek"
	ref GetStockUDF = CompileScript "SaintsVendingMachines\Stock\GetStock.gek"

	ref PlayMenuOpenSoundUDF = CompileScript "SaintsVendingMachines\Sound\PlayMenuOpenSound.gek"

	; Init

	if eval rObject == 0
		return
	endif

	; Stock

	array_var aProductIndices = Ar_Construct "array"
	array_var aProductItems = Call GetProductItemsUDF
	array_var aProductPrices = Call GetProductPricesUDF
	array_var aProductStock = Call GetStockUDF rObject
	array_var aProducts = Ar_Keys aProductItems

	; Run

	if eval (aProductStock["_Any"] > 0)
		; Alternative text for bottle caps:
		; "This vending machine has been modified to accept contemporary currency.%rYou have %g Bottle Caps in your inventory."
		string_var sMenuText = "^Nuka-Cola Vending Machine^This vending machine accepts legal US tender.%rYou have $%g in your inventory."
		
		foreach array_var aEntry <- aProducts
			short iIndex = aEntry["key"]
			string_var sProduct = aEntry["value"]

			if eval !(Ar_HasKey aProductStock $sProduct) || !(Ar_HasKey aProductPrices $sProduct)
				continue
			endif

			short iStock = aProductStock[$sProduct]
			short iPrice = aProductPrices[$sProduct]

			if iStock < 1
				continue
			endif

			string_var sLine = Sv_Construct "|%z ($%g)" ($sProduct) (iPrice * 10)
			let sMenuText += sLine

			Ar_Append aProductIndices iIndex
			Sv_Destruct sLine
		loop

		; Finalize

		let sMenuText += "|Cancel"

		; Sounds

		ref rOpenSound = GetContainerSound rObject 0

		if eval IsFormValid rOpenSound
			rObject.PlaySound rOpenSound 1
		endif

		Call PlayMenuOpenSoundUDF

		; Message

		Player.AuxiliaryVariableSetRef "*SVM_aLastVendingMachine" rObject
		Player.AuxiliaryVariableSetFromArray "*SVM_aLastProductIndices" aProductIndices
	
		short iPlayerCurrency = Player.GetItemCount PrewarMoney
		MessageBoxExAlt OnMenuConfirmUDF ($sMenuText) (iPlayerCurrency * 10)

	else
		MessageExAlt 2 "Interface\Icons\Message Icons\glow_message_vaultboy_sad.dds|This vending machine is out of stock."
	endif

	; Clean-Up

	Sv_Destruct sMenuText

	let aProducts := Ar_Null
	let aProductItems := Ar_Null
	let aProductStock := Ar_Null
	let aProductPrices := Ar_Null
	let aProductIndices := Ar_Null

end