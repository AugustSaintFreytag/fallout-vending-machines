begin function { ref rObject }

	; UDFs

	ref GetObjectSeedUDF = CompileScript "SaintsVendingMachines\SVM_GetObjectSeed.gek"
	ref GetSeededRandomChanceUDF = CompileScript "SaintsVendingMachines\SVM_GetSeededRandomChance.gek"
	ref GetRegionalBonusUDF = CompileScript "SaintsVendingMachines\SVM_GetRegionalBonus.gek"
	
	; Factors

	float fStockFactor = 1.0
	short iStockBonus = (Call GetRegionalBonusUDF)

	; Random

	short iMachineSeed = (Call GetObjectSeedUDF rObject)
	short iMachineSeedTick = 0

	ref GetRandomChanceUDF = (begin function {} 
		short iLocalSeed = iMachineSeed + iMachineSeedTick
		short iChance = (Call GetSeededRandomChanceUDF iLocalSeed)

		let iChance *= (1 + (1 - fStockFactor))
		let iChance -= iStockBonus

		PrintC "Returning random chance with seed %g, tick %g, result %g." iLocalSeed iMachineSeedTick iChance

		SetFunctionValue iChance
		let iMachineSeedTick := iMachineSeedTick + 1`
	end)

	; Vending

	short bHasAnyStock = 0
	short bHasStockNukaCola = 0
	short bHasStockNukaColaQuantum = 0
	short bHasStockNukaColaQuartz = 0
	short bHasStockNukaColaVictory = 0

	; Stock Pseudo-Randomization

	if eval Player.IsInInterior == 1
		let bHasStockNukaCola := (Call GetRandomChanceUDF) < 70
		let bHasStockNukaColaQuantum := (Call GetRandomChanceUDF) < 50
		let bHasStockNukaColaQuartz := (Call GetRandomChanceUDF) < 10
		let bHasStockNukaColaVictory := (Call GetRandomChanceUDF) < 5
	else
		let bHasStockNukaCola := (Call GetRandomChanceUDF) < 50
		let bHasStockNukaColaQuantum := (Call GetRandomChanceUDF) < 20
		let bHasStockNukaColaQuartz := (Call GetRandomChanceUDF) < 0
		let bHasStockNukaColaVictory := (Call GetRandomChanceUDF) < 0
	endif

	let bHasAnyStock := eval (bHasStockNukaCola || bHasStockNukaColaQuantum || bHasStockNukaColaQuartz || bHasStockNukaColaVictory)

	PrintC "Set vending machine stock: Classic (%g), Quantum (%g), Quartz (%g), Victory (%g)." bHasStockNukaCola bHasStockNukaColaQuantum bHasStockNukaColaQuartz bHasStockNukaColaVictory

	; Return

	array_var aStockByProduct = Ar_Construct "stringmap"

	let aStockByProduct["_Any"] := bHasAnyStock
	let aStockByProduct["Nuka-Cola"] := bHasStockNukaCola
	let aStockByProduct["Nuka-Cola Quantum"] := bHasStockNukaColaQuantum
	let aStockByProduct["Nuka-Cola Quartz"] := bHasStockNukaColaQuartz
	let aStockByProduct["Nuka-Cola Victory"] := bHasStockNukaColaVictory

	SetFunctionValue aStockByProduct

end